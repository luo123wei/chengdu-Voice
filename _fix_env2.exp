#!/usr/bin/expect -f
set timeout 120
set server_ip "223.6.254.101"
set ssh_pass "1234@Lwpj"

spawn ssh -o StrictHostKeyChecking=no root@$server_ip "
echo '--- PM2 版本 ---'
pm2 -v
echo ''
echo '--- PM2 配置文件是否含 env_file ---'
cat /var/www/geoscope/ecosystem.config.js | head -18
echo ''
echo '--- 尝试直接用 env_file 作为 env_file_path 属性(部分版本PM2写法不同) ---'
cat > /var/www/geoscope/ecosystem.config.js <<'EOFEOF'
module.exports = {
  apps: [
    {
      name: 'geoscope-1',
      script: 'node_modules/.bin/next',
      args: 'start --port 5001',
      cwd: '/var/www/geoscope',
      instances: 1,
      exec_mode: 'fork',
      env_file: '.env.production',
      env: {
        NODE_ENV: 'production',
        NEXT_PUBLIC_APP_URL: 'http://223.6.254.101:5000',
        NODE_OPTIONS: '--dns-result-order=ipv4first'
      },
      max_memory_restart: '512M',
      error_file: '/var/log/geoscope-error.log',
      out_file: '/var/log/geoscope-out.log',
      merge_logs: true,
      time: true
    },
    {
      name: 'geoscope-2',
      script: 'node_modules/.bin/next',
      args: 'start --port 5002',
      cwd: '/var/www/geoscope',
      instances: 1,
      exec_mode: 'fork',
      env_file: '.env.production',
      env: {
        NODE_ENV: 'production',
        NEXT_PUBLIC_APP_URL: 'http://223.6.254.101:5000',
        NODE_OPTIONS: '--dns-result-order=ipv4first'
      },
      max_memory_restart: '512M',
      error_file: '/var/log/geoscope-2-error.log',
      out_file: '/var/log/geoscope-2-out.log',
      merge_logs: true,
      time: true
    }
  ]
};
EOFEOF
echo '已写入新 ecosystem,现在重启 PM2(先 delete 再 start,强制重新加载) ---'
cd /var/www/geoscope
pm2 delete geoscope-1 geoscope-2
pm2 start ecosystem.config.js
sleep 5
echo ''
echo '--- PID ---'
CPID=\$(pm2 pid geoscope-1)
echo 'geoscope-1 PID=' \$CPID
echo '--- /proc/PID/environ 里有没有 ADMIN ---'
cat /proc/\$CPID/environ 2>/dev/null | tr '\0' '\n' | grep -E 'ADMIN|CAPTCHA' | head -10
echo ''
echo '--- 如仍无,换一个方案:手动在env块里写死ADMIN变量 ---'
echo ''
"
expect {
    "password:" { send "$ssh_pass\r"; exp_continue }
    eof { }
}
