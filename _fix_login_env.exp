#!/usr/bin/expect -f
set timeout 300
set server_ip "223.6.254.101"
set ssh_pass "1234@Lwpj"

puts "===== [1] 先看 PM2 进程实际环境变量 ====="
spawn ssh -o StrictHostKeyChecking=no root@$server_ip "pm2 show geoscope-1 | grep -E 'ADMIN_|env' ; echo '---重启后变量---'; pm2 env 0 2>/dev/null | grep -E 'ADMIN_'"
expect {
    "password:" { send "$ssh_pass\r"; exp_continue }
    eof { }
}

puts ""
puts "===== [2] 用 --update-env 重启(让新变量生效) ====="
spawn ssh -o StrictHostKeyChecking=no root@$server_ip "cd /var/www/geoscope && pm2 restart geoscope-1 --update-env && pm2 restart geoscope-2 --update-env && sleep 3 && pm2 env 0 2>/dev/null | grep -E 'ADMIN_'"
expect {
    "password:" { send "$ssh_pass\r"; exp_continue }
    eof { }
}

puts ""
puts "===== [3] 验证登录(先拿真captchaId,再用真密码登录) ====="
spawn ssh -o StrictHostKeyChecking=no root@$server_ip "bash -s <<'EOF'
# 用node写一个完整end-to-end:获取captchaId -> 解密拿到答案 -> 用答案+真密码登录
cd /var/www/geoscope
node <<'NODEEOF'
const crypto = require('crypto');
const http = require('http');

// 1. 模拟获取 captchaId 并解密
const HASH = process.env.ADMIN_PASSWORD_HASH;
console.log('环境变量 ADMIN_PASSWORD_HASH 存在:', !!HASH, HASH ? HASH.substring(0,20)+'...' : '无');
console.log('环境变量 ADMIN_EMAIL:', process.env.ADMIN_EMAIL || '无');

// 2. 用pbkdf2验证密码
const PASSWORD='Ks8&fM3!wZdP#qR5v';
if (HASH) {
  const [salt,expected] = HASH.split('\$');
  const actual = crypto.pbkdf2Sync(PASSWORD, salt, 100000, 64, 'sha512').toString('hex');
  const match = crypto.timingSafeEqual(Buffer.from(actual,'hex'), Buffer.from(expected,'hex'));
  console.log('哈希密码匹配(PBKDF2):', match);
}
NODEEOF

echo ''
echo '--- 现在尝试完整登录流程 ---'
# 获取验证码
RESP=\$(curl -s -D- -o /tmp/c.svg http://127.0.0.1:5001/api/auth/captcha)
CID=\$(echo "\$RESP" | grep -i 'x-captcha-id:' | tr -d '\r' | sed -E 's/.*:\s*//')
echo 'captchaId:' \$CID
# 用node解密出答案
ANSWER=\$(cd /var/www/geoscope && node -e "
const SECRET = (() => {
  const h = require('crypto').createHash('sha256').update(process.env.ADMIN_PASSWORD_HASH).digest('hex');
  return h;
})();
const b = Buffer.from('\$CID','base64url');
const iv = b.subarray(0,12), tag = b.subarray(12,28), enc = b.subarray(28);
const d = require('crypto').createDecipheriv('aes-256-gcm', Buffer.from(SECRET,'hex'), iv);
d.setAuthTag(tag);
const s = Buffer.concat([d.update(enc), d.final()]).toString('utf8');
console.log(JSON.parse(s).a);
")
echo '验证码答案:' \$ANSWER

# 真实登录
echo ''
echo '--- POST /login (admin@geoscope.com + 正确密码 + 正确验证码) ---'
curl -s -X POST http://127.0.0.1:5001/api/auth/login -H 'Content-Type: application/json' \
  -d "{\"email\":\"admin@geoscope.com\",\"password\":\"Ks8&fM3!wZdP#qR5v\",\"captcha\":\"\$ANSWER\",\"captchaId\":\"\$CID\"}"
echo
EOF
"
expect {
    "password:" { send "$ssh_pass\r"; exp_continue }
    eof { }
}
