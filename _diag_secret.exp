#!/usr/bin/expect -f
set timeout 300
set server_ip "223.6.254.101"
set ssh_pass "1234@Lwpj"

puts "===== 用API route打印 SECRET 校验和(临时文件,验证完删) ====="
spawn ssh -o StrictHostKeyChecking=no root@$server_ip "
mkdir -p /var/www/geoscope/src/app/api/diag
cat > /var/www/geoscope/src/app/api/diag/route.ts <<'TSEND'
import { NextResponse } from 'next/server';
import crypto from 'crypto';
export const dynamic = 'force-dynamic';
export function GET() {
  const H = process.env.ADMIN_PASSWORD_HASH || 'MISSING';
  const E = process.env.ADMIN_EMAIL || 'MISSING';
  const SECRET = crypto.createHash('sha256').update(H).digest('hex');
  return NextResponse.json({
    email: E,
    hash_len: H.length,
    hash_prefix: H.substring(0,24)+'...',
    secret_len: SECRET.length,
    secret_byte_len: Buffer.from(SECRET,'hex').length,
    secret_sha256: crypto.createHash('sha256').update(SECRET).digest('hex').substring(0,32),
  });
}
TSEND
cd /var/www/geoscope && npm run build 2>&1 | tail -5
pm2 restart all --update-env
sleep 6
echo ''
echo '=== API 结果 ==='
curl -s http://127.0.0.1:5001/api/diag
echo ''
echo '=== 独立脚本同算法计算的 SECRET 校验 ==='
node -e \"
const crypto=require('crypto');
const fs=require('fs');
// 从 /proc/PID/environ 直接拿到 ADMIN_PASSWORD_HASH,避免脚本加载偏差
const pid=require('child_process').execSync('pm2 pid geoscope-1').toString().trim();
const env=fs.readFileSync('/proc/'+pid+'/environ').toString().split('\\\\0').reduce((o,l)=>{const[i,...r]=l.split('=');const v=r.join('=');o[i]=v;return o;},{});
const H=env.ADMIN_PASSWORD_HASH||'';
const SECRET=crypto.createHash('sha256').update(H).digest('hex');
console.log(JSON.stringify({
  email: env.ADMIN_EMAIL,
  hash_len: H.length,
  hash_prefix: H.substring(0,24)+'...',
  secret_len: SECRET.length,
  secret_byte_len: Buffer.from(SECRET,'hex').length,
  secret_sha256: crypto.createHash('sha256').update(SECRET).digest('hex').substring(0,32),
},null,2));
\"
echo ''
echo '=== 删除临时路由 + 重新 build 清理 ==='
rm -rf /var/www/geoscope/src/app/api/diag
npm run build 2>&1 | tail -3
pm2 restart all --update-env
"
expect {
    "password:" { send "$ssh_pass\r"; exp_continue }
    eof { }
}
